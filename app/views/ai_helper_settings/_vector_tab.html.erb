<% f = tab[:f] %>
<div class="box tabular">
  <p>
    <%= f.check_box :vector_search_enabled %>
  </p>
  <div id="ai-helper-vector-search">
    <fieldset class="box" id="ai-helper-qdrant-connection" data-config='<%= {
      testConnectionUrl: ai_helper_settings_test_vector_connection_path,
      testConnectionSuccessLabel: l("ai_helper.model_profiles.test_connection_success"),
      testConnectionFailedLabel: l("ai_helper.model_profiles.test_connection_failed"),
      loadingLabel: l(:label_loading)
    }.to_json %>'>
      <legend><%= l("ai_helper.vector_search.qdrant_server") %></legend>
      <p><em class="info"><%= l("ai_helper.vector_search.qdrant_server_description") %></em></p>
      <p>
        <%= f.text_field :vector_search_uri, size: 60, required: true %>
      </p>
      <p>
        <%= f.text_field :vector_search_api_key, size: 60 %>
        <span class="description"><%= l("ai_helper.vector_search.qdrant_api_key_description") %></span>
      </p>
      <p id="ai-helper-vector-test-connection">
        <button type="button" id="ai-helper-vector-test-connection-btn"><%= l("ai_helper.model_profiles.test_connection") %></button>
        <span id="ai-helper-vector-test-connection-result" role="status" aria-live="polite"></span>
      </p>
    </fieldset>
    <p>
      <%= f.check_box :use_vector_model_profile %>
      <span class="description"><%= t("activerecord.attributes.ai_helper_setting.vector_model_profile_description") %></span>
    </p>
    <div id="ai-helper-vector-model-profile-settings">
      <p>
        <%= f.select :vector_model_profile_id, ai_helper_model_profile_options(@model_profiles), include_blank: true %>
      </p>
    </div>
    <p>
      <%= f.text_field :embedding_model, size: 60 %>
    </p>
    <div id="ai-helper-embedding-connection" data-config='<%= {
      testConnectionUrl: ai_helper_settings_test_embedding_connection_path,
      testConnectionSuccessLabel: l("ai_helper.model_profiles.test_connection_success"),
      testConnectionFailedLabel: l("ai_helper.model_profiles.test_connection_failed"),
      dimensionLabel: l("ai_helper.vector_search.embedding_dimension"),
      loadingLabel: l(:label_loading)
    }.to_json %>'>
      <p id="ai-helper-embedding-test-connection">
        <button type="button" id="ai-helper-embedding-test-connection-btn"><%= l("ai_helper.model_profiles.test_connection") %></button>
        <span id="ai-helper-embedding-test-connection-result" role="status" aria-live="polite"></span>
      </p>
    </div>
    <p>
      <%= f.check_box :vector_register_all_projects %>
      <span class="description"><%= t("activerecord.attributes.ai_helper_setting.vector_register_all_projects_description") %></span>
    </p>
    <div id="ai-helper-vector-target-projects" style="<%= 'display: none;' if @setting.vector_register_all_projects %>">
      <% if @vector_candidate_projects.any? %>
        <% selected_project_ids = @setting.vector_target_project_ids.to_a %>
        <fieldset class="box" id="ai_helper_vector_target_project_ids">
          <legend><%= toggle_checkboxes_link("#ai_helper_vector_target_project_ids input[type=checkbox]") %><%= t(:label_project_plural) %></legend>
          <div class="objects-selection">
            <%= render_project_nested_lists(@vector_candidate_projects) do |p|
              content_tag('label', check_box_tag('ai_helper_setting[vector_target_project_ids][]', p.id, selected_project_ids.include?(p.id), :id => nil) + ' ' + h(p), :class => 'block')
            end %>
          </div>
          <%= hidden_field_tag('ai_helper_setting[vector_target_project_ids][]', '', :id => nil) %>
        </fieldset>
      <% end %>
    </div>
  </div>
</div>
