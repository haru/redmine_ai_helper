<% content_for :header_tags do %>
  <%= stylesheet_link_tag('ai_helper.css', plugin: :redmine_ai_helper) %>
  <%= javascript_include_tag('settings/ai_helper_chat_settings.js', plugin: :redmine_ai_helper) %>
  <%= javascript_include_tag('settings/ai_helper_settings.js', plugin: :redmine_ai_helper) %>
  <%= javascript_include_tag('settings/ai_helper_model_profile.js', plugin: :redmine_ai_helper) %>
<% end %>
<h2><%= t(:label_ai_helper) %></h2>
<div id="ai-helper-settings-index" data-config='<%= {
  modelProfilesPath: ai_helper_model_profiles_path,
  loadErrorMessage: l(:ai_helper_error_occurred),
  compatibleType: RedmineAiHelper::LlmProvider::LLM_OPENAI_COMPATIBLE,
  azureType: RedmineAiHelper::LlmProvider::LLM_AZURE_OPENAI,
  userIdSupportedTypes: [
    RedmineAiHelper::LlmProvider::LLM_OPENAI,
    RedmineAiHelper::LlmProvider::LLM_OPENAI_COMPATIBLE,
    RedmineAiHelper::LlmProvider::LLM_AZURE_OPENAI
  ]
}.to_json %>'>
<%= labelled_form_for @setting, url: ai_helper_setting_update_url, method: :post do |f| %>
  <%= error_messages_for(@setting, *(@chat_adapter_settings&.values || [])) %>
  <%= hidden_field_tag :tab, @selected_tab %>
  <%= render_tabs ai_helper_settings_tabs(f), @selected_tab %>
  <%= f.submit t(:button_submit) %>
<% end %>
</div>
<script>initAiHelperSettingsPage();</script>
