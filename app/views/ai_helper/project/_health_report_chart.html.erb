<%# The DOM states of a chart directive position (canvas for bar/stacked, a
    number tile, no data, unavailable) (contracts/http-and-dom.md).
    The canvas payload travels in a data attribute so that it is never touched
    by linkify_issue_references, and every value is ERB-escaped here. Only
    Redmine's existing classes are used (no new CSS).
    The localized draw-failure message travels with the canvas: when Chart.js
    cannot draw it, the JS shows this text instead of an unexplained blank
    box.
    The item labels (each already carrying its count) follow the canvas as a
    list hidden with Redmine's .hidden-for-sighted class, read right after
    the canvas, so screen readers get the values the canvas only shows as
    pixels. The list stays outside the chart container because
    Chart.js sizes the canvas from a container dedicated to it. %>
<% if resolved.is_a?(RedmineAiHelper::HealthReportChart::Chart) %>
  <% if resolved.no_data? %>
<div class="ai-helper-health-report-chart">
  <p><strong><%= resolved.title %></strong></p>
  <p class="nodata"><%= l(:label_no_data) %></p>
</div>
  <% elsif resolved.form == :tile %>
<div class="ai-helper-health-report-chart box">
  <p><strong><%= resolved.title %></strong></p>
  <h2><%= resolved.summary %></h2>
</div>
  <% else %>
<div class="ai-helper-health-report-chart issue-report-graph"
     data-chart-error-message="<%= l("ai_helper.health_report_chart.draw_failed") %>">
  <canvas role="img" aria-label="<%= resolved.title %>"
          data-ai-helper-chart="<%= { form: resolved.form.to_s,
                                      title: resolved.title,
                                      labels: resolved.items.map(&:label),
                                      values: resolved.items.map(&:value),
                                      fillColors: resolved.items.map(&:fill_color),
                                      borderColors: resolved.items.map(&:border_color) }.to_json %>"></canvas>
</div>
<ul class="hidden-for-sighted">
    <% resolved.items.each do |item| %>
  <li><%= item.label %></li>
    <% end %>
</ul>
  <% end %>
<% else %>
<div class="ai-helper-health-report-chart">
  <p class="warning"><%= resolved.message %></p>
</div>
<% end %>
