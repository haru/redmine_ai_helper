<% @conversation.messages.each do |message| %>
  <div class="aihelper-message">
    <% case message.role %>
    <% when 'user' %>
      <div class="aihelper-message-user">
        <%= avatar(@user) %>
        <strong><%= link_to_user(@user) %></strong>
      </div>
      <pre><%= message.content %></pre>
    <% when 'context' %>
      <div class="aihelper-message-user">
        <strong><%= l("ai_helper.chat_channel.context.label") %></strong>
      </div>
      <%# User questions and imported chat channel messages are both rendered
          as escaped plain text in a <pre> tag. Context messages are untrusted
          external input, so they must never go through md_to_html. %>
      <pre><%= message.content %></pre>
    <% else %>
      <div>
        <%= linkify_issue_references(md_to_html(message.content)) %>
      </div>
    <% end %>
  </div>
<% end %>
<div class="aihelper-message">
  <div id="aihelper_last_message"></div>
</div>

<% unless @conversation.messages.empty? %>
  <script>
    ai_helper.setClearButtonVisible(true);
  </script>
<% else %>
  <script>
    ai_helper.setClearButtonVisible(false);

  </script>
<% end %>
<div id="ai-helper-loader-area" style="display: none">
  <div class="ai-helper-loader"></div>
</div>
