<% if RedmineAiHelper::Util::PermissionChecker.module_enabled?(project: @project, permission: { controller: :ai_helper, action: :chat_form }) and AiHelperSetting.find_or_create.model_profile and User.current.allowed_to?(:add_issues, @project) %>

<span id="ai-helper-subissuer-generator-menu">
<%= link_to sprite_icon("ai-helper-robot", l('ai_helper.generate_sub_issues.title'), plugin: :redmine_ai_helper), '#', onclick: "showSubissuerGenerator(); return false;", class: "ai-helper-subissuer-generator-button" %> |
</span>

<div id="ai-helper-subissuer-generator-area" display="none">
<%= render partial: 'ai_helper/issues/subissues/index', locals: {issue: @issue} %>
</div>

<% end %>
