
<% if RedmineAiHelper::Util::PermissionChecker.module_enabled?(project: @project, permission: { controller: :ai_helper, action: :issue_summary }) and AiHelperSetting.find_or_create.model_profile %>
<%
  summary = AiHelperSummaryCache.issue_cache(issue_id: @issue.id)
%>
<fieldset id="ai-helper-summary-fields" class="collapsible collapsed" data-config='<%= {
  userId: User.current.id,
  summaryUrl: ai_helper_issue_summary_path(id: @issue.id),
  generateUrl: ai_helper_generate_issue_summary_path(id: @issue.id),
  similarIssuesUrl: ai_helper_similar_issues_path(id: @issue.id),
  errorMessage: l(:ai_helper_error_occurred),
  hasSummary: summary.present?
}.to_json %>'>
    <legend onclick="toggleFieldset(this);aiHelperSaveSummaryState();" class="icon icon-collapsed">
    <%= sprite_icon("angle-right") %>
    <strong>
        <%= sprite_icon("ai-helper-robot", plugin: :redmine_ai_helper)%>
        <%= l(:ai_helper_summary) %>
    </strong>
    </legend>
    <div class="ai-helper-issue-summary" style="display: none;">
      <div id="ai-helper-summary-area">
        <% unless summary %>
        <%= link_to l(:ai_helper_summary), '#', class: 'ai-helper-summary-button', id: 'ai-helper-summary-button', onclick: 'generateSummaryStream(); return false;' %>
        <% end %>

      </div>
    </div>

</fieldset>

<% end %>

<% if RedmineAiHelper::Util::PermissionChecker.module_enabled?(project: @project, permission: { controller: :ai_helper, action: :similar_issues }) and AiHelperSetting.find_or_create.model_profile and AiHelperSetting.vector_search_enabled_for?(@project) %>
<div id="ai-helper-similar-issues-section" style="border-top: 1px solid #ccc; padding-top: 10px; margin-top: 10px;">
    <div class="contextual">
    </div>
    <%= link_to '#', class: 'ai-helper-similar-issues-button icon icon-list', id: 'ai-helper-similar-issues-button', onclick: 'findSimilarIssues(); return false;', style: 'text-decoration: none; font-weight: bold; font-size: 14px;' do %>
        <%= sprite_icon("ai-helper-robot", plugin: :redmine_ai_helper)%>
        <%= l(:ai_helper_similar_issues) %>
    <% end %>
    <span id="ai-helper-similar-issues-scope" class="ai-helper-scope-toggle">
      <label><input type="radio" name="ai_helper_scope" value="current"> <%= l(:ai_helper_scope_current_project) %></label>
      <label><input type="radio" name="ai_helper_scope" value="with_subprojects" checked> <%= l(:ai_helper_scope_with_subprojects) %></label>
      <label><input type="radio" name="ai_helper_scope" value="all"> <%= l(:ai_helper_scope_all_projects) %></label>
    </span>
    <div id="ai-helper-similar-issues-area">
    </div>
</div>
<% end %>
