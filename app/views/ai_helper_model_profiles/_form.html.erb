<%= content_for :header_tags do %>
  <%= stylesheet_link_tag 'ai_helper', plugin: 'redmine_ai_helper' %>
<% end %>
<%= error_messages_for "model_profile" %>
<div id="ai-helper-model-profile-form" class="box tabular" data-config='<%= {
  compatibleType: RedmineAiHelper::LlmProvider::LLM_OPENAI_COMPATIBLE,
  azureType: RedmineAiHelper::LlmProvider::LLM_AZURE_OPENAI,
  openaiType: RedmineAiHelper::LlmProvider::LLM_OPENAI,
  testConnectionUrl: ai_helper_model_profiles_test_connection_path,
  testConnectionFailedLabel: l("ai_helper.model_profiles.test_connection_failed"),
  testConnectionSuccessLabel: l("ai_helper.model_profiles.test_connection_success")
}.to_json %>'>
  <p><%= f.select :llm_type, RedmineAiHelper::LlmProvider.option_for_select %></p>
  <p>
    <%= f.text_field :name, size: 60, required: true, autocomplete: "off" %>
  </p>
  <%
      access_key = ""
      access_key = AiHelperModelProfilesController::DUMMY_ACCESS_KEY unless @model_profile.new_record?
  %>
  <p id="ai-helper-mode-access-key"><%= f.password_field :access_key, value: access_key, size: 60, required: true, autocomplete: "new-password", readonly: true %></p>
  <p id="ai-helper-model-llm-model">
    <%= f.text_field :llm_model, size: 60, required: true %>
  </p>
  <p id="ai-helper-model-llm-model">
    <%= f.text_field :temperature, size: 60, required: true %>
  </p>
  <p id="ai-helper-model-max-tokens">
    <%= f.text_field :max_tokens, size: 60 %>
  </p>
  <p id="ai-helper-model-organization-id">
    <%= f.text_field :organization_id, size: 60, autocomplete: "off", readonly: true %>
  </p>
  <p id="ai-helper-model-base-uri">
    <%= f.text_field :base_uri, size: 90, required: true %>
  </p>
  <p id="ai-helper-model-http-proxy">
    <%= f.text_field :http_proxy, size: 90 %>
  </p>


  <p id="ai-helper-test-connection">
    <%= hidden_field_tag :id, @model_profile.id unless @model_profile.new_record? %>
    <button type="submit" id="ai-helper-test-connection-btn">
      <%= l("ai_helper.model_profiles.test_connection") %>
    </button>
    <span id="ai-helper-test-connection-result"></span>
  </p>
</div>
