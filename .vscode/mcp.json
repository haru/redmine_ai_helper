{
	"servers": {
		"context7": {
			"type": "stdio",
			"command": "npx",
			"args": [
				"-y",
				"@upstash/context7-mcp"
			],
			"env": {}
		},
		"playwright": {
			"type": "stdio",
			"command": "npx",
			"args": [
				"-y",
				"@playwright/mcp@0.0.84",
				"--browser",
				"chromium",
				"--executable-path",
				"/usr/bin/chromium",
				"--headless",
				"--no-sandbox"
			],
			"env": {}
		},
		"redmine": {
			"type": "http",
			"url": "http://localhost:3000/ai_helper/mcp",
			"headers": {
				"X-Redmine-API-Key": "${env:REDMINE_API_KEY}"
			}
		}
	}
}
