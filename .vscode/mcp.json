{
	"servers": {
		"context7": {
			"type": "stdio",
			"command": "npx",
			"args": [
				"-y",
				"@upstash/context7-mcp"
			],
			"env": {}
		},
		"serena": {
			"type": "stdio",
			"command": "uvx",
			"args": [
				"--from",
				"git+https://github.com/oraios/serena",
				"serena",
				"start-mcp-server",
				"--context",
				"ide-assistant",
				"--project",
				"/usr/local/redmine/plugins/redmine_ai_helper"
			],
			"env": {}
		},
		"playwright": {
			"type": "stdio",
			"command": "npx",
			"args": [
				"-y",
				"@playwright/mcp@latest",
				"--cdp-endpoint",
				"ws://browserless:3000"
			],
			"env": {}
		},
		"redmine": {
			"type": "http",
			"url": "http://localhost:3000/ai_helper/mcp",
			"headers": {
				"X-Redmine-API-Key": "${env:REDMINE_API_KEY}"
			}
		}
	}
}
