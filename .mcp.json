{
  "mcpServers": {
    "context7": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@upstash/context7-mcp"
      ],
      "env": {}
    },
    "spec-workflow": {
      "command": "npx",
      "args": [
        "-y",
        "@pimzino/spec-workflow-mcp@latest",
        "--AutoStartDashboard"
      ]
    },
    "deepwiki": {
      "type": "sse",
      "url": "https://mcp.deepwiki.com/sse"
    },
    "serena": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "--from",
        "git+https://github.com/oraios/serena",
        "serena",
        "start-mcp-server",
        "--context",
        "ide-assistant",
        "--project",
        "/usr/local/redmine/plugins/redmine_ai_helper"
      ],
      "env": {}
    },
    "playwright": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@latest",
        "--cdp-endpoint",
        "ws://browserless:3000"
      ],
      "env": {}
    },
    "github": {
      "type": "http",
      "url": "https://api.githubcopilot.com/mcp",
      "headers": {
        "Authorization": "Bearer ${GITHUB_PERSONAL_ACCESS_TOKEN}"
      }
    },
    "langfuse": {
      "type": "http",
      "url": "${LANGFUSE_URL}/api/public/mcp",
      "headers": {
        "Authorization": "Basic ${LANGFUSE_API_KEY} "
      }
    },
    "redmine": {
      "type": "http",
      "url": "http://localhost:3000/ai_helper/mcp",
      "headers": {
        "X-Redmine-API-Key": "${REDMINE_API_KEY}"
      }
    }
  }
}
